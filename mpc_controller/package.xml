<?xml version="1.0"?>
<package format="3">
  <name>mpc_controller</name>
  <version>1.0.0</version>
  <description>Zephyr fixed-base arm or mobile manipulator MPC controller using upstream OCS2 libraries.</description>
  <maintainer email="yipeng.xia@hotmail.com">xiayip</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <depend>pluginlib</depend>
  <depend>controller_interface</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>realtime_tools</depend>
  <depend>ocs2_mobile_manipulator</depend>
  <depend>ocs2_controller_common</depend>
  <depend>arms_controller_common</depend>
  <depend>arms_rviz_control_plugin</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>arms_ros2_control_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>rviz_rendering</depend>
  <depend>rviz_ogre_vendor</depend>
  <depend>rviz_common</depend>
  <depend>qtbase5-dev</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>eigen</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
